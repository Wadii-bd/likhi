{
  "name": "likhi",
  "productName": "Likhi",
  "version": "2.0.1",
  "description": "Likhi — a free interactive whiteboard for teachers",
  "main": "main.js",
  "author": "Likhi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.likhi.board",
    "productName": "Likhi",
    "copyright": "Likhi",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Likhi",
      "artifactName": "Likhi-Setup-${version}.exe"
    },
    "portable": { "artifactName": "Likhi-Portable-${version}.exe" },
    "fileAssociations": [
      { "ext": "likhi", "name": "Likhi board", "description": "Likhi whiteboard", "icon": "build/icon.ico" }
    ]
  }
}
